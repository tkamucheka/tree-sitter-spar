{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "spar",
      "camelcase": "Spar",
      "title": "SPAR",
      "scope": "source.spar",
      "file-types": [
        "spar"
      ],
      "injection-regex": "^spar$",
      "class-name": "TreeSitterSpar"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for SPAR assembly",
    "authors": [
      {
        "name": "Tendayi Kamucheka",
        "url": "https://tkamucheka.github.io/"
      }
    ],
    "links": {
      "repository": "https://github.com/tkamucheka/tree-sitter-spar"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
